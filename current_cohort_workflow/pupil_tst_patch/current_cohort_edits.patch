+%                                                        probability map (7th output of pupil_mask_frame)
+%   info.source 'unet' | 'none', .score (max probability of the kept blob), .diam, .center, .best_* (best blob even
+%   below thr), .threshold
+if nargin < 3 || isempty(thr), thr = 0.9; end

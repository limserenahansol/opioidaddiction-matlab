+CC = bwconncomp(mask); info.n_cand = CC.NumObjects;
+mx = cellfun(@(ix) max(prob(ix)), CC.PixelIdxList);
+[best, b] = max(mx);
+keep(CC.PixelIdxList{b}) = true;
+R = regionprops(keep, 'EquivDiameter', 'Centroid');
+info.best_src = 'unet'; info.best_score = best; info.best_diam = R(1).EquivDiameter; info.best_center = R(1).Centroid;
+info.score = best;

diff --git a/pupil/pupil_hybrid_mask.m b/pupil/pupil_hybrid_mask.m
new file mode 100644
--- /dev/null
+++ b/pupil/pupil_hybrid_mask.m
@@ -0,0 +1,162 @@
+function [mask, info] = pupil_hybrid_mask(C, maskUNet, opts)
+% CURRENT-COHORT ADDITION 2026-11-14 (new file; used only with Detector = hybrid / "pupil_detector": "hybrid").
+% SUPERSEDED 2026-11-15: use "pupil_detector": "maxp" with pupil/model/current_rig_pupil_unet.mat instead (on
+% labelled held-out frames: pupil found 82 % vs 44 %, wrong picks 23 % vs 45 % for this rule). Kept for comparison only.
+% pupil_hybrid_mask  Pupil mask for the CURRENT rig, same rules for every mouse (no per-mouse settings).
+%
+% Why: the general U-Net was trained on the previous rig (whole face at 720x540, dark iris). On the current 1080p
+% side view it often misses a clearly visible pupil (small dark disc in a grey iris) or returns a fragment of it.
+%
+% How (per frame):
+%  1) glint pixels (>= 98th percentile, dilated) are filled from their surroundings; the crop is smoothed (sigma 1)
+%     and normalised to its 1st..99th percentile -> N in [0,1].
+%  2) a ladder of dark thresholds (percentiles of N) gives nested dark regions. Regions that are too small, touch the
+%     crop edge, are not round (circularity) or not convex (solidity) are dropped.
+%  3) nested regions are linked into chains (the same dark spot growing as the threshold rises). For each chain the
+%     pupil is the INNERMOST region with a clear edge (ring contrast >= min_contrast), grown outward threshold by
+%     threshold while it stays round and does not jump in area (> max_growth x: it would be merging with the iris /
+%     dark eye). This keeps the pupil apart from a dark iris and from eyelid shadows.
+%  4) chains are scored by edge contrast x circularity x solidity x stability x closeness to the glint (the corneal
+%     reflection of the IR light lies on or next to the pupil); the best chain gives the pupil.
+%  5) a U-Net blob that has an edge of its own (ring contrast >= unet_edge, round) is used instead: the pupil as the
+%     previous cohort's U-Net defined it (it may lie inside a larger dark iris). A U-Net fragment inside a uniformly
+%     dark pupil has no edge of its own and is ignored, so the dark-region pupil of step 4 is kept.
+%  No pupil (eye closed, blur, all-dark eye without a pupil edge) -> empty mask: no value rather than a wrong one.
+%
+%   [mask, info] = pupil_hybrid_mask(C, maskUNet [, opts])   C = raw uint8 ROI crop, maskUNet = package mask or []
+%   info.source = 'unet' | 'dark' | 'none', .diam, .center, .score, .contrast, .circ, .n_chain
+if nargin < 3, opts = struct(); end
+o = defaults(opts);
+C = double(C); [H, W] = size(C);
+mask = false(H, W);
+info = struct('source', 'none', 'score', 0, 'contrast', NaN, 'circ', NaN, 'diam', NaN, 'center', [NaN NaN], 'n_chain', 0);
+G = C >= prctile(C(:), o.glint_pct);
+G = imdilate(G, strel('disk', o.glint_dilate));
+Cf = C; if any(G(:)) && nnz(G) < 0.3 * numel(G), Cf = regionfill(C, G); end
+Cb = imgaussfilt(Cf, o.smooth_sigma);
+lo = prctile(Cb(:), 1); hi = prctile(Cb(:), 99);
+N = min(max((Cb - lo) / max(1, hi - lo), 0), 1);
+minA = pi * (o.min_diam / 2) ^ 2; maxD = o.max_diam_frac * min(H, W);
+% glint centre(s) for the closeness term
+GL = regionprops(imdilate(C >= prctile(C(:), 99.5), strel('disk', 1)), 'Centroid', 'Area');
+gl = zeros(0, 2); if ~isempty(GL), gl = cat(1, GL([GL.Area] >= 3).Centroid); end
+% ---- 2) nested candidates
+qs = prctile(N(:), o.ladder);
+cand = struct('m', {}, 't', {}, 'area', {}, 'diam', {}, 'cx', {}, 'cy', {}, 'circ', {}, 'sol', {}, 'con', {});
+for t = 1:numel(qs)
+    B = imfill(imopen(N <= qs(t), strel('disk', 1)), 'holes');
+    CC = bwconncomp(B);
+    R = regionprops(CC, 'Area', 'Centroid', 'Perimeter', 'Solidity', 'EquivDiameter', 'BoundingBox');
+    for i = 1:numel(R)
+        if R(i).Area < minA || R(i).EquivDiameter > maxD, continue; end
+        bb = R(i).BoundingBox;
+        if bb(1) <= 1.5 || bb(2) <= 1.5 || bb(1) + bb(3) >= W - 0.5 || bb(2) + bb(4) >= H - 0.5, continue; end
+        circ = min(1, 4 * pi * R(i).Area / max(1, R(i).Perimeter) ^ 2);
+        m = false(H, W); m(CC.PixelIdxList{i}) = true;
+        cand(end+1) = struct('m', m, 't', t, 'area', R(i).Area, 'diam', R(i).EquivDiameter, 'cx', R(i).Centroid(1), ...
+            'cy', R(i).Centroid(2), 'circ', circ, 'sol', R(i).Solidity, 'con', ring_contrast(N, m, R(i).EquivDiameter, G)); %#ok<AGROW>
+    end
+end
+if isempty(cand), cand = cand([]); end
+% ---- 3) chains: link each candidate to the region that contains it at the next threshold
+nC = numel(cand); parent = zeros(1, nC);
+for i = 1:nC
+    for j = 1:nC
+        if cand(j).t == cand(i).t + 1 && nnz(cand(i).m & cand(j).m) >= 0.9 * cand(i).area
+            parent(i) = j; break
+        end
+    end
+end
+isLeaf = true(1, nC); isLeaf(parent(parent > 0)) = false;
+best = []; bestScore = -inf; chains = 0;
+for i = find(isLeaf)
+    % walk from the innermost region outward
+    path = i; k = i;
+    while parent(k) > 0, k = parent(k); path(end+1) = k; end %#ok<AGROW>
+    sel = 0;
+    for p = 1:numel(path)
+        q = cand(path(p));
+        good = q.circ >= o.min_circ && q.sol >= o.min_solidity && q.con >= o.min_contrast;
+        if sel == 0
+            if good, sel = p; end
+        else
+            prev = cand(path(sel));
+            if good && q.area <= o.max_growth * prev.area && q.con >= 0.6 * prev.con, sel = p; else, break; end
+        end
+    end
+    if sel == 0, continue; end
+    q = cand(path(sel)); chains = chains + 1;
+    stab = sel_stability(cand, path, sel);
+    prox = 1;
+    if ~isempty(gl)
+        dg = min(hypot(gl(:,1) - q.cx, gl(:,2) - q.cy)) / max(q.diam / 2, 4);
+        prox = max(o.min_prox, exp(-max(0, dg - 1.5) / 3));
+    end
+    sc = q.con * q.circ * q.sol * min(1, stab / o.full_stab) * prox;
+    if sc > bestScore, bestScore = sc; best = q; end
+end
+info.n_chain = chains;
+% ---- 5) U-Net blobs: keep the best one that has an edge of its own (as the previous cohort's U-Net pupils)
+ub = []; ubs = -inf;
+if ~isempty(maskUNet) && any(maskUNet(:))
+    CC = bwconncomp(maskUNet); R = regionprops(CC, 'Area', 'Centroid', 'EquivDiameter', 'Perimeter', 'Solidity');
+    for i = 1:numel(R)
+        if R(i).Area < minA || R(i).EquivDiameter > maxD, continue; end
+        m = false(H, W); m(CC.PixelIdxList{i}) = true;
+        circ = min(1, 4 * pi * R(i).Area / max(1, R(i).Perimeter) ^ 2);
+        cu = ring_contrast(N, m, R(i).EquivDiameter, G);
+        s_u = cu * circ * R(i).Solidity;
+        if circ >= o.min_circ && cu >= o.unet_edge && s_u > ubs, ubs = s_u; ub = struct('m', m, 'con', cu, 'circ', circ); end
+    end
+end
+if ~isempty(ub)
+    mask = ub.m; info = fill_info(info, mask, 'unet'); info.score = ubs; info.contrast = ub.con; info.circ = ub.circ;
+    return
+end
+if isempty(best) || bestScore < o.min_score, return; end
+mask = imclose(best.m, strel('disk', 1));
+info = fill_info(info, mask, 'dark'); info.score = bestScore; info.contrast = best.con; info.circ = best.circ;
+end
+
+function s = sel_stability(cand, path, sel)
+% how many consecutive thresholds around the selected one keep a similar region (MSER-like stability)
+s = 1; d0 = cand(path(sel)).diam;
+for p = sel - 1:-1:1, if cand(path(p)).diam >= 0.7 * d0, s = s + 1; else, break; end, end
+for p = sel + 1:numel(path), if cand(path(p)).diam <= 1.3 * d0, s = s + 1; else, break; end, end
+end
+
+function c = ring_contrast(N, m, d, G)
+r = max(2, round(0.3 * d));
+ring = imdilate(m, strel('disk', r)) & ~m & ~G; inside = m & ~G;
+if nnz(ring) < 5 || nnz(inside) < 5, c = 0; return; end
+c = median(N(ring)) - median(N(inside));
+end
+
+function mask = unet_only(maskUNet, N, G, o)
+% no dark-blob pupil: keep a U-Net blob only if it is round, dark and has an edge
+mask = false(size(N));
+if isempty(maskUNet) || ~any(maskUNet(:)), return; end
+CC = bwconncomp(maskUNet); R = regionprops(CC, 'Area', 'EquivDiameter', 'Perimeter');
+bestc = 0;
+for i = 1:numel(R)
+    m = false(size(N)); m(CC.PixelIdxList{i}) = true;
+    circ = min(1, 4 * pi * R(i).Area / max(1, R(i).Perimeter) ^ 2);
+    c = ring_contrast(N, m, R(i).EquivDiameter, G);
+    if circ >= o.min_circ && c >= o.min_contrast && c * circ > bestc, bestc = c * circ; mask = m; end
+end
+end
+
+function info = fill_info(info, mask, src)
+R = regionprops(mask, 'EquivDiameter', 'Centroid', 'Area');
+if isempty(R), return; end
+[~, i] = max([R.Area]);
+info.source = src; info.diam = R(i).EquivDiameter; info.center = R(i).Centroid;
+end
+
+function o = defaults(o)
+d = struct('glint_pct', 98, 'glint_dilate', 2, 'smooth_sigma', 1.0, 'min_diam', 5, 'max_diam_frac', 0.45, ...
+    'ladder', [1 2 3 4 5 7 9 12 15 18 22 26 30 35], 'min_circ', 0.6, 'min_solidity', 0.8, 'min_contrast', 0.12, ...
+    'max_growth', 1.6, 'full_stab', 3, 'min_prox', 0.35, 'min_score', 0.05, 'unet_edge', 0.08);
+f = fieldnames(d);
+for i = 1:numel(f), if ~isfield(o, f{i}), o.(f{i}) = d.(f{i}); end, end
+end
